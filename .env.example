DATABASE_URL=postgresql+psycopg://ats:ats@localhost:5432/ats

JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ats_minio
MINIO_SECRET_KEY=ats_minio_secret
MINIO_BUCKET=resumes
MINIO_SECURE=false

REDIS_URL=redis://localhost:6379/0

# Job-queue broker (evaluation-pack export, review F09/F26 migration — see
# docs/plans/rabbitmq-airflow-migration.md). Matches docker-compose.yml's
# rabbitmq service defaults; guest/guest is dev-only, override in production.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# In-process background sweep (expire overdue assessment attempts -> disqualify
# overdue applications). Enable on EXACTLY ONE process — a single dev run, or one
# designated worker in a multi-replica deployment. A Postgres advisory lock also
# guards each tick. See docs/decisions/D06-scheduler-ownership.md.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15

# Comma-separated allowed CORS origins for browser frontends. "*" allows any origin
# (credentials disabled in that case). Set explicit origins in production, e.g.:
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://192.168.1.59:5173
CORS_ALLOW_ORIGINS=*

# Default admin seeded by `uv run python -m app.scripts.create_admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User
ADMIN_CONTACT_NUMBER=N/A
